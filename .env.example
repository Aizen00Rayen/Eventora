# ── Django Backend ──────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-very-secret-key-change-in-production

# Database — set DB_ENGINE=sqlite for local dev (no PostgreSQL needed)
#             set DB_ENGINE=postgresql to use a real PostgreSQL server
DB_ENGINE=sqlite
DB_NAME=eventora
DB_USER=eventora
DB_PASSWORD=eventora_secret
DB_HOST=localhost
DB_PORT=5432

# Email — set EMAIL_MODE=console to print emails to terminal (default for local dev)
#          set EMAIL_MODE=smtp to send real emails via SMTP
EMAIL_MODE=console

# CORS
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Email (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Eventora <noreply@eventora.com>

# ── React Frontend ───────────────────────────────────────────
REACT_APP_API_URL=http://localhost:8000
